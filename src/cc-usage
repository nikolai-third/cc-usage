#!/usr/bin/env python3
"""Show Claude Code subscription usage and configure the statusline segment and limit hook.

  cc-usage                    usage table
  cc-usage --json             raw API response
  cc-usage --cache            fetch silently and refresh the cache (used internally)
  cc-usage config             show settings
  cc-usage config limit NAME [--warn N|on|off] [--stop N|on|off] [--show|--hide] [--reset]
  cc-usage config hook [on|off] [--repeat-warn N] [--repeat-stop N]
  cc-usage config style percent|bar [--width N]   statusline look
  cc-usage config context on|off    context window fill in the statusline
  cc-usage config message warn|stop "TEXT" | --reset
  cc-usage config reset       restore default settings

Limit names: session, weekly, and the model name for model-scoped limits (e.g. fable).
Each limit has a soft level (--warn: finish current work and tell the user) and a hard
level (--stop: write a handoff and stop). A number sets the level and turns it on;
off/on switch it without losing the number.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cc_usage_core as core  # noqa: E402


def print_table(data):
    for name, lim in core.limits_from(data).items():
        print(f"{name:14} {lim['percent']:>3}%   resets {core.format_time(lim.get('resets_at'))}")

    spend = data.get("spend") or {}
    if spend.get("enabled"):
        used, limit = spend["used"], spend["limit"]
        k = 10 ** used["exponent"]
        print(f"{'extra usage':14} {spend['percent']:>3}%   "
              f"{used['amount_minor'] / k:.2f} / {limit['amount_minor'] / k:.2f} {used['currency']}")


def show_usage(args):
    try:
        data = core.fetch()
    except core.UsageError as e:
        if args.cache:
            sys.exit(1)
        sys.exit(f"cc-usage: {e}")
    core.write_cache(data)
    if args.cache:
        return
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        print_table(data)


# --- config ----------------------------------------------------------------

def level_value(value):
    if value.lower() in ("on", "off"):
        return value.lower()
    try:
        pct = int(value.rstrip("%"))
    except ValueError:
        raise argparse.ArgumentTypeError(f"expected a percentage, 'on' or 'off', got {value!r}")
    if not 1 <= pct <= 100:
        raise argparse.ArgumentTypeError("percentage must be between 1 and 100")
    return pct


def positive(value):
    n = int(value)
    if n < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return n


def fmt_level(settings, level):
    return f"{settings[level]}% {'on' if settings[f'{level}_on'] else 'off'}"


def show_config(config):
    limits, _ = core.load_limits()
    names = list(limits) + [n for n in config["limits"] if n not in limits]
    print(f"{'limit':14} {'now':>5}   {'soft (warn)':12} {'hard (stop)':12} statusline")
    for name in names:
        s = core.limit_settings(config, name)
        now = f"{limits[name]['percent']}%" if name in limits else "?"
        notes = []
        if name not in config["limits"]:
            notes.append("default")
        if name in limits and core.model_of(limits[name]):
            notes.append(f"hook only while running {core.model_of(limits[name])}")
        note = f"   ({', '.join(notes)})" if notes else ""
        print(f"{name:14} {now:>5}   {fmt_level(s, 'warn'):12} {fmt_level(s, 'stop'):12} "
              f"{'shown' if s['show'] else 'hidden'}{note}")
    st = config["statusline"]
    style = f"bar, width {st['bar_width']}" if st["style"] == "bar" else "percent"
    print(f"\nstatusline: {style}; context {'on' if st['context'] else 'off'}")
    hook = config["hook"]
    print(f"hook: {'on' if hook['enabled'] else 'off'} - repeat warning every "
          f"{hook['repeat_warn']} tool calls, stop every {hook['repeat_stop']}")
    print(f"warn message: {hook['warn_message'] or 'built-in'}")
    print(f"stop message: {hook['stop_message'] or 'built-in'}")
    print(f"\nconfig file: {core.CONFIG}")


def config_limit(config, args):
    name = args.name.lower()
    if args.reset:
        config["limits"].pop(name, None)
    else:
        entry = config["limits"].setdefault(name, {})
        for level in core.LEVELS:
            value = getattr(args, level)
            if value is None:
                continue
            if value != "off":
                entry[f"{level}_on"] = True
                if value != "on":
                    entry[level] = value
            else:
                entry[f"{level}_on"] = False
        if args.show is not None:
            entry["show"] = args.show
        s = core.limit_settings(config, name)
        warn, stop = core.threshold(s, "warn"), core.threshold(s, "stop")
        if warn is not None and stop is not None and warn >= stop:
            sys.exit("cc-usage: the soft level (warn) must be lower than the hard level (stop)")
    limits, _ = core.load_limits()
    if name not in limits:
        print(f"note: no '{name}' limit in the current usage data; known: {', '.join(limits) or '-'}")


def config_hook(config, args):
    if args.state:
        config["hook"]["enabled"] = args.state == "on"
    if args.repeat_warn:
        config["hook"]["repeat_warn"] = args.repeat_warn
    if args.repeat_stop:
        config["hook"]["repeat_stop"] = args.repeat_stop


def config_style(config, args):
    config["statusline"]["style"] = args.style
    if args.width:
        config["statusline"]["bar_width"] = args.width


def config_context(config, args):
    config["statusline"]["context"] = args.state == "on"


def config_message(config, args):
    key = f"{args.level}_message"
    if args.reset or not args.text:
        config["hook"][key] = None
    else:
        config["hook"][key] = args.text


def config_reset(config, args):
    wrapped = config.get("wrapped_statusline")
    config.clear()
    config.update(json.loads(json.dumps(core.DEFAULT_CONFIG)))
    config["wrapped_statusline"] = wrapped


def build_parser():
    parser = argparse.ArgumentParser(prog="cc-usage", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--json", action="store_true", help="print the raw API response")
    parser.add_argument("--cache", action="store_true", help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command")

    cfg = sub.add_parser("config", help="show or change settings")
    cfg_sub = cfg.add_subparsers(dest="action")

    limit = cfg_sub.add_parser("limit", help="thresholds and statusline visibility of one limit")
    limit.add_argument("name", help="session, weekly, or a model name such as fable")
    limit.add_argument("--warn", type=level_value, metavar="N|on|off",
                       help="soft level: finish current work and tell the user")
    limit.add_argument("--stop", type=level_value, metavar="N|on|off",
                       help="hard level: write a handoff and stop")
    vis = limit.add_mutually_exclusive_group()
    vis.add_argument("--show", dest="show", action="store_true", default=None)
    vis.add_argument("--hide", dest="show", action="store_false")
    limit.add_argument("--reset", action="store_true", help="back to the default for this limit")
    limit.set_defaults(func=config_limit)

    hook = cfg_sub.add_parser("hook", help="enable/disable the hook and set reminder frequency")
    hook.add_argument("state", nargs="?", choices=["on", "off"])
    hook.add_argument("--repeat-warn", type=positive, metavar="N")
    hook.add_argument("--repeat-stop", type=positive, metavar="N")
    hook.set_defaults(func=config_hook)

    style = cfg_sub.add_parser("style", help="statusline look: plain percentages or progress bars")
    style.add_argument("style", choices=["percent", "bar"])
    style.add_argument("--width", type=positive, metavar="N", help="bar width in characters")
    style.set_defaults(func=config_style)

    ctx = cfg_sub.add_parser("context", help="context window fill in the statusline")
    ctx.add_argument("state", choices=["on", "off"])
    ctx.set_defaults(func=config_context)

    msg = cfg_sub.add_parser("message", help="custom instruction the agent gets at a level")
    msg.add_argument("level", choices=["warn", "stop"])
    msg.add_argument("text", nargs="?")
    msg.add_argument("--reset", action="store_true", help="back to the built-in message")
    msg.set_defaults(func=config_message)

    reset = cfg_sub.add_parser("reset", help="restore default settings")
    reset.set_defaults(func=config_reset)
    return parser


def main():
    args = build_parser().parse_args()
    if args.command != "config":
        show_usage(args)
        return
    config = core.load_config()
    if getattr(args, "func", None):
        args.func(config, args)
        core.save_config(config)
    show_config(config)


if __name__ == "__main__":
    main()
